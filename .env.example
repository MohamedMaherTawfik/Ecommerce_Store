APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_INSTALLED=false
APP_DEBUG=false
APP_URL=http://localhost:8000
ALLOW_ADMIN_ENV_EDITOR=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=default

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =======================
# DATABASE
# =======================
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

# =======================
# SESSION
# =======================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# =======================
# CACHE
# =======================
CACHE_STORE=file
CACHE_DRIVER=file
CACHE_PREFIX=

# =======================
# REDIS (غير مستخدم حاليًا)
# =======================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =======================
# MAIL
# =======================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =======================
# AWS (optional)
# =======================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =======================
# FRONTEND
# =======================
VITE_APP_NAME="${APP_NAME}"
SEO_SITE_NAME="${APP_NAME}"
SEO_TITLE_SUFFIX="${APP_NAME}"
SEO_DEFAULT_TITLE="Premium Products Online"
SEO_DEFAULT_DESCRIPTION="Discover quality products, trusted reviews, secure checkout, and fast delivery."
SEO_DEFAULT_IMAGE="/images/logo.png"
SEO_TWITTER_SITE=

PASSWORD_RESET_OTP_TTL=10
ANALYTICS_CACHE_MINUTES=5
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# =======================
# API KEY
# =======================
API_KEY=CHANGE_ME_FOR_LOCAL_DEVELOPMENT_ONLY

# =======================
# PAYPAL (optional)
# =======================
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_CHECKOUT_WEBHOOK_ID=
PAYPAL_WALLET_WEBHOOK_ID=

# =======================
# STRIPE (optional)
# =======================
STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# =======================
# CHECKOUT / TAX / INVOICE
# =======================
CHECKOUT_CURRENCY=USD
TAX_ENABLED=true
SHIPPING_ENABLED=true
DEFAULT_FLAT_SHIPPING_RATE=10
COD_CONFIRMS_ORDER=false
STOCK_DEDUCTION_MODE=order_placement
RESTORE_STOCK_ON_CANCEL=true
RESTORE_STOCK_ON_RETURN=true
ADMIN_NOTIFICATION_EMAIL=
COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_TAX_NUMBER=
INVOICE_PREFIX=INV
INVOICE_NEXT_NUMBER=1

# =======================
# EASYPOST SHIPPING (optional)
# =======================
EASYPOST_API_KEY=
EASYPOST_TEST_MODE=true
EASYPOST_FROM_NAME=
EASYPOST_FROM_COMPANY=
EASYPOST_FROM_PHONE=
EASYPOST_FROM_EMAIL=
EASYPOST_FROM_STREET1=
EASYPOST_FROM_STREET2=
EASYPOST_FROM_CITY=
EASYPOST_FROM_STATE=
EASYPOST_FROM_ZIP=
EASYPOST_FROM_COUNTRY=

# =======================
# EXTRA PAYMENT GATEWAYS (optional)
# =======================
PAYMOB_ENABLED=false
PAYMOB_SECRET_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CURRENCY=EGP

MYFATOORAH_ENABLED=false
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_COUNTRY_ISO=KWT
MYFATOORAH_CURRENCY=KWD
MYFATOORAH_WEBHOOK_SECRET=

PAYMENT_SUCCESS_URL=
PAYMENT_FAILED_URL=
PAYMENT_CANCEL_URL=

BIONEER_API_KEY=
BIONEER_SECRET=
BIONEER_MODE=test

# =======================
# GOOGLE LOGIN (optional)
# =======================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/users/google-callback
GOOGLE_REDIRECT_URL="${GOOGLE_REDIRECT_URI}"
