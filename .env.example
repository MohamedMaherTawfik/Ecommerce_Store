APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_INSTALLED=false
APP_DEBUG=false
APP_URL=https://api.store.example.com
ALLOW_ADMIN_ENV_EDITOR=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=default

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =======================
# DATABASE
# =======================
DB_CONNECTION=mysql
DB_DATABASE=ecommerce_store
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=

# =======================
# SESSION
# =======================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

AUTH_COOKIE_NAME=store_auth_token
AUTH_COOKIE_LIFETIME=120
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=null
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=strict
SANCTUM_EXPIRATION=120
SANCTUM_STATEFUL_DOMAINS=store.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# =======================
# CACHE
# =======================
CACHE_STORE=database
CACHE_DRIVER=database
CACHE_PREFIX=

# =======================
# REDIS (غير مستخدم حاليًا)
# =======================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =======================
# MAIL
# =======================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =======================
# AWS (optional)
# =======================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =======================
# FRONTEND
# =======================
VITE_APP_NAME="${APP_NAME}"
SEO_SITE_NAME="${APP_NAME}"
SEO_TITLE_SUFFIX="${APP_NAME}"
SEO_DEFAULT_TITLE="Premium Products Online"
SEO_DEFAULT_DESCRIPTION="Discover quality products, trusted reviews, secure checkout, and fast delivery."
SEO_DEFAULT_IMAGE="/images/logo.png"
SEO_TWITTER_SITE=

PASSWORD_RESET_OTP_TTL=10
ANALYTICS_CACHE_MINUTES=5
FRONTEND_URL=https://store.example.com
VITE_API_URL=https://api.store.example.com
CORS_ALLOWED_ORIGINS=https://store.example.com

# =======================
# CHECKOUT / TAX / INVOICE
# =======================
CHECKOUT_CURRENCY=EGP
TAX_ENABLED=true
SHIPPING_ENABLED=true
DEFAULT_FLAT_SHIPPING_RATE=10
STOCK_DEDUCTION_MODE=order_placement
RESTORE_STOCK_ON_CANCEL=true
RESTORE_STOCK_ON_RETURN=true
ADMIN_NOTIFICATION_EMAIL=
COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_TAX_NUMBER=
INVOICE_PREFIX=INV
INVOICE_NEXT_NUMBER=1

# =======================
# EASYPOST SHIPPING (optional)
# =======================
EASYPOST_API_KEY=
EASYPOST_TEST_MODE=true
EASYPOST_FROM_NAME=
EASYPOST_FROM_COMPANY=
EASYPOST_FROM_PHONE=
EASYPOST_FROM_EMAIL=
EASYPOST_FROM_STREET1=
EASYPOST_FROM_STREET2=
EASYPOST_FROM_CITY=
EASYPOST_FROM_STATE=
EASYPOST_FROM_ZIP=
EASYPOST_FROM_COUNTRY=

# =======================
# PAYMOB
# =======================
PAYMOB_ENABLED=false
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_INTEGRATION_ID_APPLE_PAY=
PAYMOB_CURRENCY=EGP
PAYMOB_IFRAME_ID=
PAYMOB_CALLBACK_URL="${APP_URL}/api/v1/payment/paymob/callback"
PAYMOB_WEBHOOK_URL="${APP_URL}/api/v1/webhooks/paymob"
PAYMENT_SUCCESS_URL=
PAYMENT_FAILED_URL=
PAYMENT_CANCEL_URL=

# =======================
# GOOGLE LOGIN (optional)
# =======================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.store.example.com/api/v1/users/google-callback
GOOGLE_REDIRECT_URL="${GOOGLE_REDIRECT_URI}"
